{
  "expo": {
    "name": "PickTime Book",
    "slug": "mobile",
    "version": "1.0.0",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/images/logopick-time.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "orientation": "portrait",
    "icon": "./assets/images/logopick-time.jpg",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.cesargomez853.saasapp",
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "splash": {
        "image": "./assets/images/logopick-time.jpg",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "package": "com.cesargomez853.saasapp",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logopick-time.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/logopick-time.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logopick-time.jpg",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}